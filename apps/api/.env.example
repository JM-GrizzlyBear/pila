# Copy this file to apps/api/.env and fill in your own values.
# Never commit apps/api/.env (it's in .gitignore).

PORT=4000

# Local Postgres from docker compose. Same user, password and database as the root .env.
DATABASE_URL=postgres://pila:pick_a_password@127.0.0.1:5432/pila?sslmode=disable

# Signs the login cookies. Any long random string: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# The first admin. Created once, when the API starts and there's no admin yet;
# after that these are ignored (change the password in Pila instead).
# There's no public sign-up: this admin adds everyone else (Accounts).
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
